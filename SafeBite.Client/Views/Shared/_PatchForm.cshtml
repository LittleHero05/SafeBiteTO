@model PatchFieldForm
@* Shared PATCH form. ViewData["Fields"] = the fields this resource allows (JSON Patch path -> label) *@
@{ var fields = (Dictionary<string, string>)ViewData["Fields"]!; }
<form asp-action="Patch" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Field" class="form-label">Field to change</label>
        <select asp-for="Field" class="form-select" asp-items="@(new SelectList(fields, "Key", "Value"))"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Value" class="form-label"></label>
        <textarea asp-for="Value" class="form-control" rows="3"></textarea>
    </div>
    <p class="small text-muted">Sends <code>PATCH</code> with a JSON Patch document:
        <code>[{ "op": "replace", "path": "&lt;field&gt;", "value": "&lt;new value&gt;" }]</code></p>
    <button type="submit" class="btn btn-warning">Send PATCH</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-link">Cancel</a>
</form>
