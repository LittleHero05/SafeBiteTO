@model List<OwnerResponseDto>
@{ ViewData["Title"] = "Owner responses"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Owner responses <small class="text-muted fs-6">GET /api/owner-responses</small></h1>
    <a asp-action="Create" class="btn btn-primary">+ New response (POST)</a>
</div>
<table class="table table-sm table-hover align-middle">
    <thead><tr><th>ID</th><th>Inspection</th><th>Owner</th><th>Message</th><th>Posted</th><th></th></tr></thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.OwnerResponseId</td>
            <td><a asp-controller="Inspections" asp-action="Details" asp-route-id="@r.InspectionId">#@r.InspectionId</a></td>
            <td>@r.OwnerName</td>
            <td class="small">@r.Message</td>
            <td class="text-nowrap">@r.CreatedAt.ToString("yyyy-MM-dd")</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@r.OwnerResponseId" class="btn btn-sm btn-outline-primary">Details</a>
                <a asp-action="Edit" asp-route-id="@r.OwnerResponseId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Patch" asp-route-id="@r.OwnerResponseId" class="btn btn-sm btn-outline-warning">Patch</a>
                <a asp-action="Delete" asp-route-id="@r.OwnerResponseId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="text-muted small">@Model.Count responses</p>
