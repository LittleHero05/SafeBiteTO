@model OwnerResponseCreateDto
@{ ViewData["Title"] = "New owner response"; }
<h1 class="h3">Respond to an inspection <small class="text-muted fs-6">POST /api/owner-responses</small></h1>
<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3"><label asp-for="InspectionId" class="form-label"></label><input asp-for="InspectionId" class="form-control" /><span asp-validation-for="InspectionId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="OwnerName" class="form-label"></label><input asp-for="OwnerName" class="form-control" placeholder="Management, RESTAURANT NAME" /><span asp-validation-for="OwnerName" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Message" class="form-label"></label><textarea asp-for="Message" class="form-control" rows="4"></textarea><span asp-validation-for="Message" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Send POST</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
