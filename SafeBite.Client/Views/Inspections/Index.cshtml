@model List<InspectionDto>
@{
    ViewData["Title"] = "Inspections";
    var estId = ViewData["EstablishmentId"] as int?;
    var status = ViewData["Status"] as string;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Inspections <small class="text-muted fs-6">GET /api/inspections</small></h1>
    <a asp-action="Create" asp-route-establishmentId="@estId" class="btn btn-primary">+ New inspection (POST)</a>
</div>
<form method="get" class="mb-3 d-flex gap-2" style="max-width:520px">
    <input name="establishmentId" value="@estId" type="number" class="form-control" placeholder="Establishment ID" />
    <select name="status" class="form-select">
        <option value="">Any status</option>
        @foreach (var s in new[] { "Pass", "Conditional Pass", "Closed" })
        {
            <option value="@s" selected="@(s == status)">@s</option>
        }
    </select>
    <button class="btn btn-outline-secondary">Filter</button>
</form>
<table class="table table-sm table-hover align-middle">
    <thead><tr><th>ID</th><th>Date</th><th>Establishment</th><th>Status</th><th>Infractions</th><th>Summary</th><th></th></tr></thead>
    <tbody>
    @foreach (var i in Model)
    {
        <tr>
            <td>@i.InspectionId</td>
            <td class="text-nowrap">@i.InspectionDate.ToString("yyyy-MM-dd")</td>
            <td>@i.EstablishmentName</td>
            <td><partial name="_StatusPill" model="i.Status" /></td>
            <td>@i.InfractionCount</td>
            <td class="small">@i.InfractionSummary</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@i.InspectionId" class="btn btn-sm btn-outline-primary">Details</a>
                <a asp-action="Edit" asp-route-id="@i.InspectionId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Patch" asp-route-id="@i.InspectionId" class="btn btn-sm btn-outline-warning">Patch</a>
                <a asp-action="Delete" asp-route-id="@i.InspectionId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="text-muted small">@Model.Count inspections</p>
