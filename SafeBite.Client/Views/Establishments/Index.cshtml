@model List<EstablishmentDto>
@{ ViewData["Title"] = "Establishments"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Establishments <small class="text-muted fs-6">GET /api/establishments</small></h1>
    <a asp-action="Create" class="btn btn-primary">+ New establishment (POST)</a>
</div>
<form method="get" class="mb-3 d-flex gap-2" style="max-width:420px">
    <input name="search" value="@ViewData["Search"]" class="form-control" placeholder="Search by name" />
    <button class="btn btn-outline-secondary">Search</button>
</form>
<table class="table table-sm table-hover align-middle">
    <thead><tr><th>ID</th><th>Name</th><th>Street</th><th>Postal code</th><th>Phone</th><th></th></tr></thead>
    <tbody>
    @foreach (var e in Model)
    {
        <tr>
            <td>@e.EstablishmentId</td>
            <td>@e.Name</td>
            <td>@e.Street</td>
            <td>@e.PostalCode</td>
            <td>@e.Phone</td>
            <td class="text-end text-nowrap">
                <a asp-action="Details" asp-route-id="@e.EstablishmentId" class="btn btn-sm btn-outline-primary">Details</a>
                <a asp-action="Edit" asp-route-id="@e.EstablishmentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Patch" asp-route-id="@e.EstablishmentId" class="btn btn-sm btn-outline-warning">Patch</a>
                <a asp-action="Delete" asp-route-id="@e.EstablishmentId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>
<p class="text-muted small">@Model.Count establishments</p>
